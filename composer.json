{
  "name": "wexample/symfony-signature-ds",
  "description": "Design-system screens for symfony-signature: composing an envelope, signing it — signed in or through a signed link —, following it, verifying a file, and one's own signature",
  "version": "3.0.11",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonySignatureDs\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-signature": ">=2.0.6",
    "wexample/symfony-media-ds": ">=3.0.5",
    "wexample/symfony-design-system": ">=41.0.0",
    "wexample/symfony-forms": ">=14.0.2",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-loader": ">=26.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}